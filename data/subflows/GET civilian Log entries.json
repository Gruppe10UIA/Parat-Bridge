    "func": "const connection = msg.payload;\nconst clients    = Object.values(connection.clients);\nconst target     = clients.find(c => c.client_system === \"wasos\");\nconst source     = clients.find(c => c.client_system !== \"wasos\");\n\nmsg.topic    = source.client_system;\nmsg.metadata = {\n    source:     source,\n    target:     target,\n    connection: connection\n};\n\nreturn msg;\n",
