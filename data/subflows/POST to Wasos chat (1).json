[
  {
    "id": "61f685a3bc5e8d53",
    "type": "subflow",
    "name": "POST to Wasos chat (1)",
    "info": "Posts a bridged entry to the WaSOS chat API.\n\n### Input\n`msg.payload` = WaSOS POST body, `msg.metadata.target` = WaSOS Client\n\n### Logic\nSets `x-api-key` header, URL `/api/chat/messages/{chatroom_name}`, sends POST. 500ms delay between requests.\n\nWhen files are present, Wasos file Hanlding does the POST directly via\nnodeFetch (multipart). A bypass switch routes those messages straight to\nReturn response, skipping the HTTP node.\n\n### Output\n`msg.topic = \"response\"`, `msg.result = true/false`, `msg.statusCode`",
    "category": "",
    "in": [
      {
        "x": 100,
        "y": 200,
        "wires": [
          {
            "id": "274d01098c112c18"
          }
        ]
      }
    ],
    "out": [
      {
        "x": 360,
        "y": 380,
        "wires": [
          {
            "id": "5c52c8029f1e8069",
            "port": 0
          }
        ]
      }
    ],
    "env": [],
    "meta": {},
    "color": "#AAAA66",
    "icon": "font-awesome/fa-send"
  },
  {
    "id": "274d01098c112c18",
    "type": "switch",
    "z": "61f685a3bc5e8d53",
    "name": "files",
    "property": "metadata.files",
    "propertyType": "msg",
    "rules": [
      {
        "t": "nnull"
      },
      {
        "t": "else"
      }
    ],
    "checkall": "true",
    "repair": false,
    "outputs": 2,
    "x": 210,
    "y": 200,
    "wires": [
