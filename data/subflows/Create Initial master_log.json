    "name": "Set newest timestamp",
    "func": "let data = msg.payload\n\nconst newestTimestamp = Math.max(\n    ...data.map(entry => entry.timeCreated)\n    )\n\nglobal.set(\"last_rayvn_timestamp\", newestTimestamp);\nglobal.set(\"last_wasos_timestamp\", newestTimestamp);",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
