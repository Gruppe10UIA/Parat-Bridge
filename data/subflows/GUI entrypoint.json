  {
    "id": "82d9701bc316c966",
    "type": "function",
    "z": "99c17cced97ac339",
    "name": "Submit Form",
    "func": "// Get previously stored values (or initialize as empty)\nlet rayvnConfig = { apiKey: \"\", logName: \"\" };\nlet wasosConfig = { username: \"\", password: \"\", chatroom: \"\" };\n\n// Update the configs based on which UI element sent the message\nif (msg.topic === 'rayvn_api_key') {\n    rayvnConfig.apiKey = msg.payload;\n    context.set('rayvnConfig', rayvnConfig);\n    \n} else if (msg.topic === 'log_name') {\n    rayvnConfig.logName = msg.payload;\n    context.set('rayvnConfig', rayvnConfig);\n    \n} else if (msg.topic === 'wasos_username') {\n    wasosConfig.username = msg.payload;\n    context.set('wasosConfig', wasosConfig);\n    \n} else if (msg.topic === 'wasos_password') {\n    wasosConfig.password = msg.payload;\n    context.set('wasosConfig', wasosConfig);\n    \n} else if (msg.topic === 'chatroom_name') {\n    wasosConfig.chatroom = msg.payload;\n    context.set('wasosConfig', wasosConfig);\n    \n} else if (msg.topic === \"submit\") { // check if everything is filled\n    if (wasosConfig.username === \"\" || wasosConfig.password === \"\" || wasosConfig.chatroom === \"\") {\n        node.warn(\"Attempted to submit empty wasos form\");\n        return null;\n    }\n    \n    if (rayvnConfig.apiKey === \"\" || rayvnConfig.logName === \"\") {\n        node.warn(\"Attempted to submit empty rayvn form\");\n        return null;\n    }\n    \n    // Everything is filled! Send the data forward\n    msg.rayvnConfig = rayvnConfig;\n    msg.wasosConfig = wasosConfig;\n    return msg;\n}",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 530,
    "y": 360,
    "wires": [
