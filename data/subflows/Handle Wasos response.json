  {
    "id": "f825c79007c454f4",
    "type": "function",
    "z": "f0eb857d54dfb4ac",
    "name": "sort time",
    "func": "// Sort messages oldest-first so the filter advances the cursor correctly\nif (!msg.payload || msg.payload.length === 0) return null;\n\nmsg.payload.sort((a, b) => new Date(a.createdAt).getTime() - new Date(b.createdAt).getTime());\nreturn msg;\n",
    "outputs": 1,
