  {
    "id": "871c0cd773068b95",
    "type": "function",
    "z": "f0eb857d54dfb4ac",
    "name": "Filter",
    "func": "const cursorTs = msg.metadata.source.timestamp;\nconst bridgePattern = /\\[(?:rayvn|cim|parat_bridge)(?::|])/;\n\nmsg.payload = msg.payload.filter(entry => {\n    if (new Date(entry.createdAt).getTime() <= cursorTs) return false;\n    if (entry.content && bridgePattern.test(entry.content)) return false;\n    if (entry.username && bridgePattern.test(entry.username)) return false;\n    return true;\n});\n\nif (msg.payload.length === 0) return null;\n\n// Advance cursor to newest surviving entry (array is sorted, last = newest)\nglobal.set(\n    `parat_bridge.connections.${msg.metadata.connection_name}.clients.${msg.metadata.source.identifier}.timestamp`,\n    new Date(msg.payload[msg.payload.length - 1].createdAt).getTime()\n);\n\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
