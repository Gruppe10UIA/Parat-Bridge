    "z": "f0eb857d54dfb4ac",
    "name": "Attach image to entry",
    "func": "if (msg.mapImage) {\n    const file = {\n        name: msg.mapImage.name,\n        type: msg.mapImage.type,\n        size: msg.mapImage.buffer.length,\n        _buffer: msg.mapImage.buffer\n    };\n\n    msg.payload.files = (msg.payload.files || []).concat(file);\n    delete msg.mapImage;\n}\n\ndelete msg.geo;\ndelete msg.isLocation;\n\nreturn msg;\n",
