  {
    "id": "4b7da576ce1ab299",
    "type": "function",
    "z": "209f3c980818c499",
    "name": "Format header and url",
    "func": "let wasosApiKey = global.get('wasos_apikey');\nlet chatroomUrl = global.get('wasosChatroomUrl');\n\nif (!wasosApiKey || !chatroomUrl) {\n    node.warn('WaSOS not configured');\n    return null;\n}\n\nmsg.url = chatroomUrl;\nmsg.headers = {\n    'x-api-key': wasosApiKey,\n    'Content-Type': 'application/json'\n};\n\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
