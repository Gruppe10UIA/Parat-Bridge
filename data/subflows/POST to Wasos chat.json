  },
  {
    "id": "4b7da576ce1ab299",
    "type": "function",
    "z": "209f3c980818c499",
    "name": "Format header and url",
    "func": "const conn = msg.connection;\nconst base = global.get(\"pb\").getBaseUrl(\"wasos\");\n\nif (!conn || !conn.wasos.api.key || !conn.wasos.chatroom_name) {\n    node.error(\"WaSOS not configured on connection\");\n    return null;\n}\n\nmsg.url = base + \"/api/chat/messages/\" + conn.wasos.chatroom_name;\nmsg.headers = {\n    'x-api-key': conn.wasos.api.key,\n    'Content-Type': 'application/json'\n};\n\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 200,
    "wires": [
      [
        "4b9eb1abd60ed246"
      ]
    ],
    "info": "Builds HTTP request headers and URL for WaSOS API. Sets x-api-key header from wasos_apikey and uses wasosChatroomUrl as the endpoint. Returns null if not configured."
  },
