[
  {
    "id": "c52035853d082eb0",
    "type": "subflow",
    "name": "POST to Wasos chat",
    "info": "Posts a bridged entry to the WaSOS chat API.\n\n### Input\n`msg.payload` = WaSOS POST body, `msg.metadata.target` = WaSOS Client\n\n### Logic\nSets `x-api-key` header, URL `/api/chat/messages/{chatroom_name}`, sends POST. 500ms delay between requests.\n\n### Output\n`msg.topic = \"response\"`, `msg.result = true/false`, `msg.statusCode`",
    "category": "",
    "in": [
      {
        "x": 100,
        "y": 200,
        "wires": [
          {
            "id": "69725644404947db"
          }
        ]
      }
    ],
    "out": [
      {
        "x": 360,
        "y": 380,
        "wires": [
          {
            "id": "275fb321d293db05",
            "port": 0
          }
        ]
      }
    ],
    "env": [],
    "meta": {},
    "color": "#AAAA66",
    "icon": "font-awesome/fa-send"
  },
  {
    "id": "275fb321d293db05",
    "type": "function",
    "z": "c52035853d082eb0",
    "name": "Return response",
    "func": "msg.topic = \"response\"\n\nif (msg.statusCode == 200) {\n    msg.result = true\n} else {\n    msg.result = false\n}\n\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 180,
    "y": 360,
    "wires": [
      [
        "6e6ce6cb44b295c2"
      ]
    ]
  },
