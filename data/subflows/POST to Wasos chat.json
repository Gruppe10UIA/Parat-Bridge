  {
    "id": "c073c2ba149126e0",
    "type": "function",
    "z": "c52035853d082eb0",
    "name": "build notification",
    "func": "/**\n * Builds a notification payload for the source client.\n * Only reached after a successful POST when issues need reporting.\n */\nconst notification = {\n    payload: {\n        entry_id: msg.entry.id,\n        failed_files: msg.metadata.files.failed,\n        entry_author: msg.entry.author,\n        metadata: msg.metadata\n    }\n};\n\nreturn notification;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
