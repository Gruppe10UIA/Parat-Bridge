    "type": "function",
    "z": "0047704f35a57b0c",
    "name": "filter by label",
    "func": "let data = msg.payload\n\n// warning hardcoded label\nconst labelName = \"WaSOS\";\n\nconst filtered = data.filter(\n    entry => entry.labels.some(label => label.name === labelName)\n);\n\nmsg.payload = filtered\n\nreturn msg;",
