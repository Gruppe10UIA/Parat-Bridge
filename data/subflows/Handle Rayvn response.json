  {
    "id": "91538a46d1d6d022",
    "type": "function",
    "z": "f23580e27a5eb9f2",
    "name": "Check for manual URL (Rayvn)",
    "func": "/**\n * Checks if the Rayvn entry text contains a URL.\n *\n * URL found: files silently removed (the link IS the file).\n * No URL: pass through — Classify files already marked as NON_TRANSFERABLE.\n */\nconst url_pattern = /(?:https?:\\/\\/|ftp:\\/\\/|www\\.)\\S+/i;\nconst has_url = msg.payload.text && url_pattern.test(msg.payload.text);\n\nif (has_url) {\n    msg.payload.files = [];\n    if (msg.metadata.files) {\n        msg.metadata.files.failed = [];\n    }\n}\n\nreturn msg;\n",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 250,
    "y": 380,
    "wires": [
