    "func": "let wasos_config = {\n    username: msg.config.username,\n    user_id: msg.payload.profileId,\n    chatroom_name: msg.config.chatroom_name,\n    api: {\n        key: msg.payload.nonce,\n        expires: msg.payload.refresh_expires\n    },\n    group: msg.payload.groups,\n}\n\nglobal.set(\"wasos_config\", wasos_config)\n\nmsg.payload = wasos_config\nreturn msg;",
