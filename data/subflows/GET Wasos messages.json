    "z": "e97e0c90387d0adc",
    "name": "Build Wasos /chat/messages/ request",
    "func": "const client = msg.metadata.source;\n\n\nmsg.headers = { \"x-api-key\": client.client_specific.api.key };\nmsg.url = global.get(\"parat_bridge\").base_urls.wasos\n    + \"/api/chat/messages/\" + client.client_specific.chatroom_name + \"?limit=50\";\n\nreturn msg;\n",
