  {
    "id": "481267d96889460a",
    "type": "function",
    "z": "80f93fa22c15ece3",
    "name": "Config",
    "func": "\nflow.set(\"$parent.wasos_url\", (msg.url || env.get(\"url\")))\n\nmsg.url =  flow.get(\"$parent.wasos_url\") + \"/apisec/login\"\n\nlet user = msg.username || env.get(\"username\");\nlet pass = msg.password || env.get(\"password\");\nlet auth = Buffer.from(user + \":\" + pass).toString('base64');\n\nmsg.headers = msg.headers || {};\nmsg.headers['Authorization'] = \"Basic \" + auth;\n\nreturn msg;",
