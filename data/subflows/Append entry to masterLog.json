    "name": "append new entries",
    "func": "const masterLog = global.get(\"masterLog\") || [];\nconst newEntries = msg.payload;\n\nglobal.set(\"masterLog\", masterLog.concat(newEntries));\n\nmsg.payload = newEntries;\n\nreturn msg;",
