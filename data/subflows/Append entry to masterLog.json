    "z": "fe9d5f6f9c2bdb16",
    "name": "remove duplicate entries",
    "func": "const masterLog = global.get(\"masterLog\") || [];\nconst existingIds = new Set(masterLog.map(entry => entry.id));\n\nmsg.payload = msg.payload.filter(entry => !existingIds.has(entry.id));\n\nreturn msg;",
