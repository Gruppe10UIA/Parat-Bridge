    "id": "a6fd40ed60e5a6a7",
    "type": "function",
    "z": "1ce42ce5a45a0446",
    "name": "Set newest timestamp",
    "func": "let data = msg.payload\n\nconst newestTimestamp = Math.max(\n    ...data.map(entry => entry.timeCreated)\n    )\n\nglobal.set(\"lastRayvnEntryTimeStamp\", newestTimestamp);\nglobal.set(\"lastWasosEntryTimeStamp\", newestTimestamp);",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
