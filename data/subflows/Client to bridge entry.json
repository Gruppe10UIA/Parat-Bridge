    "name": "Rayvn to Bridge Log",
    "func": "const entry = msg.payload;\n\nmsg.payload = {\n    id:        entry.id,\n    text:      entry.text             || \"\",\n    timestamp: entry.timeCreated,\n    author:    entry.loggedByFullName || \"\",\n    files:     entry.files            || [],\n    labels:    entry.labels           || []\n};\n\nreturn msg;",
