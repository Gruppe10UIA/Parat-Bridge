    "name": "Wasos to Bridge Log",
    "func": "const entry = msg.payload;\n\nmsg.payload = {\n    id:        entry.id,\n    text:      entry.content  || \"\",\n    timestamp: new Date(entry.createdAt).getTime(),\n    author:    entry.username || \"\",\n    files:     entry.files    || [],\n    labels:    []\n};\n\nreturn msg;\n",
