      ]
    ]
  },
  {
    "id": "a247c2c515411e30",
    "type": "function",
    "z": "5b8da813a76ba94b",
    "name": "Filter by callsign",
    "func": "let data = msg.payload;\n\n// filter exclude any entries that comes from rayvn\nlet filtered = data.filter(\n    entry => !entry.callsign.includes(\"[rayvn]\")\n);\n\nmsg.payload = filtered;\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
