  {
    "id": "f70630adaa80c4a1",
    "type": "function",
    "z": "5da162b98b7b6b86",
    "name": "Set global rayvn variable",
    "func": "\nlet rayvn_config = {\n    rayvn_api_key: msg.config_variables.rayvn_api_key,\n    rayvn_log_name: msg.config_variables.rayvn_log_name,\n    rayvn_log_id: msg.payload\n}\n\nglobal.set(\"rayvn_config\", rayvn_config)\n\nreturn rayvn_config;",
    "outputs": 1,
