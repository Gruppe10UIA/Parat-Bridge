    "id": "a1b5b8de4109fab7",
    "type": "subflow",
    "name": "GET Rayn log/entries",
    "info": "Fetches all log entries from a Rayvn log via the REST API.\n\n### Input\n`msg.metadata.source` = Rayvn Client\n\n### Logic\nBuilds `GET /logs/{log_id}/entries` with `Authorization: Bearer {api_key}` from `source.client_specific`.\n\n### Output\n`msg.payload` = array of raw Rayvn entry objects",
    "category": "",
    "in": [
      {
        "x": 40,
        "y": 160,
        "wires": [
          {
            "id": "9e2296996ea77181"
          }
        ]
      }
    ],
    "out": [
      {
        "x": 1200,
        "y": 140,
        "wires": [
          {
            "id": "ae71bc183d639e62",
            "port": 0
          }
        ]
      }
    ],
    "env": [],
    "meta": {},
    "color": "#E9967A",
    "icon": "font-awesome/fa-envelope-o"
  },
  {
    "id": "9e2296996ea77181",
    "type": "function",
    "z": "a1b5b8de4109fab7",
    "name": "Build Rayvn Entry Request",
    "func": "const client = msg.metadata.source;\n\n\nmsg.url = global.get(\"parat_bridge\").base_urls.rayvn\n    + \"/logs/\" + client.client_specific.log_id + \"/entries\";\n\nmsg.headers = { \"Authorization\": \"Bearer \" + client.client_specific.api_key };\n\n\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 240,
    "y": 160,
    "wires": [
