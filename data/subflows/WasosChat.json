  {
    "id": "1398c632b8fcc9b7",
    "type": "function",
    "z": "20ed9a1c977de445",
    "name": "BuildMapChat",
    "func": "var geolocation = {\n    \"type\": \"Feature\",\n        \"geometry\": {\n        \"type\": \"Point\",\n            \"coordinates\": [\n                msg.latitude,\n                msg.longitude,\n            ]\n    },\n    \"properties\": {\n        \"name\": \"MapReference\"\n    }\n}\n\n\nmsg.payload = {\n    \"content\": JSON.stringify(geolocation),\n    \"isLocation\": true,\n    \"callsign\": msg.callsign || \"\",\n    \"replyMessageId\": null,\n    \"files\": []\n};\n\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
