  {
    "id": "64c6b59eec88e730",
    "type": "function",
    "z": "20ed9a1c977de445",
    "name": "Build image chat msg",
    "func": "// msg.payload currently holds the binary buffer from the file in node\nvar fileBuffer = Array.from(msg.payload);\n\nmsg.payload = {\n    \"content\": msg.message || \"\",\n    \"isLocation\": false,\n    \"callsign\": msg.callsign || \"\",\n    \"replyMessageId\": null,\n    \"files\": [\n        {\n            \"filename\": msg.image_file,\n            \"extension\": \"jpeg\",\n            \"filetype\": \"image/jpeg\",\n            \"blob\": fileBuffer\n        }\n    ]\n};\n\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
