    "name": "Set url and x-api-key",
    "func": "var url = flow.get(\"$parent.wasos_url\") + \"/api/chat/messages\"\nvar group = (msg.group || env.get(\"group\")) || flow.get(\"$parent.wasos_group\")\nmsg.url = url + \"/\" + group\n\nvar apikey = msg.api_key || flow.get(\"$parent.wasos_apikey\")\nmsg.headers = msg.headers || {};\nmsg.headers['x-api-key'] = apikey\nmsg.headers['Content-Type'] = 'application/json';  // ADD THIS LINE\n\nreturn msg;",
