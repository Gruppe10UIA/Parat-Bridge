  {
    "id": "7cb85bca671bd22c",
    "type": "function",
    "z": "20ed9a1c977de445",
    "name": "BuildSimpleChat",
    "func": "const payload = {\n    \"content\": msg.message,\n    \"isLocation\": false,\n    \"callsign\": msg.callsign || \"\",\n    \"replyMessageId\": null,\n    \"files\": []\n};\n\nmsg.payload = JSON.stringify(payload);  // Manually stringify!\n\nmsg.headers = msg.headers || {};\nmsg.headers['Content-Type'] = 'application/json';\n\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
