  {
    "id": "d61931ad5e5945c0",
    "type": "function",
    "z": "84d1a0de660abb59",
    "g": "9ab1f6c2842073c5",
    "name": "initialize parat bridge",
    "func": "// Base URLs for all API calls\nconst BASE_URLS = {\n    rayvn: \"https://api.rayvn.global\",\n    wasos: \"https://dev.wasos.no\"\n};\n\n// Preserve existing data across restarts\nlet data = global.get(\"parat_bridge\") || null;\n\nif (!data) {\n    // Fresh install — create empty structure\n    data = {\n        base_urls: BASE_URLS,\n        connections: []\n    };\n} else {\n    // Existing install — update base URLs, keep connections intact\n    data.base_urls = BASE_URLS;\n}\n\nglobal.set(\"parat_bridge\", data);\n\nnode.log(\"Parat-Bridge initialized: \" + data.connections.length + \" connection(s)\");\nmsg.payload = data;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 60,
