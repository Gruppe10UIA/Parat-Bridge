  {
    "id": "aad75b52978c7d99",
    "type": "function",
    "z": "901ed98289cc4ecd",
    "name": "Invalidate WaSOS API key",
    "func": "// Set the WaSOS API key to an invalid value on the first active connection\n// Used to test error handling and retry logic\nconst data = global.get(\"parat_bridge\");\nconst activeConnections = data.connections.filter(c => c.active);\n\nif (activeConnections.length === 0) {\n    node.warn(\"No active connections to invalidate\");\n    return null;\n}\n\nconst targetConnection = activeConnections[0];\ntargetConnection.wasos.api.key = \"invalid_key_for_testing\";\nglobal.set(\"parat_bridge\", data);\n\nnode.warn(\"WaSOS API key invalidated for connection: \" + targetConnection.label);\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
