    "id": "a0c5c990cb5ae106",
    "type": "function",
    "z": "901ed98289cc4ecd",
    "name": "function 1",
    "func": "const pb = global.get(\"pb\");\nconst conns = pb.getActiveConnections();\nif (conns.length === 0) {\n    node.warn(\"Ingen aktive connections\");\n    return null;\n}\nconst conn = conns[0];\nconn.rayvn.api_key = \"ugyldig_nøkkel\";\npb.updateConnection(conn.id, { rayvn: conn.rayvn });\nnode.warn(\"Rayvn API key satt til ugyldig verdi for connection: \" + conn.label);\nreturn msg;",
