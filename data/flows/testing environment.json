    "id": "a0c5c990cb5ae106",
    "type": "function",
    "z": "901ed98289cc4ecd",
    "name": "Invalidate Rayvn API key",
    "func": "const data        = global.get(\"parat_bridge\");\nconst connections = data.connections;\nconst activeNames = Object.keys(connections).filter(name => connections[name].active);\n\nif (activeNames.length === 0) {\n    node.warn(\"No active connections to invalidate\");\n    return null;\n}\n\nconst targetName = activeNames[0];\n\n// Lagre original nøkkel for restore\nflow.set(\"test_restore\", {\n    connection_name: targetName,\n    rayvn_api_key:   connections[targetName].rayvn.api_key\n});\n\nconnections[targetName].rayvn.api_key = \"invalid_key_for_testing\";\nglobal.set(\"parat_bridge.connections\", connections);\n\nnode.warn(\"Rayvn API key invalidated for: \" + targetName);\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
