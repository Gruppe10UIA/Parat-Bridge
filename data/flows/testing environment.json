  {
    "id": "18454229db48005d",
    "type": "function",
    "z": "901ed98289cc4ecd",
    "name": "Restore Rayvn Key",
    "func": "const restore = flow.get(\"test_restore\");\n\nif (!restore) {\n    node.warn(\"No stored key to restore — was invalidate run first?\");\n    return null;\n}\n\nconst connections = global.get(\"parat_bridge.connections\") || {};\nconst conn        = connections[restore.connection_name];\n\nif (!conn) {\n    node.warn(\"Connection not found: \" + restore.connection_name);\n    return null;\n}\n\nconn.rayvn.api_key = restore.rayvn_api_key;\nglobal.set(\"parat_bridge.connections\", connections);\nflow.set(\"test_restore\", null);\n\nnode.warn(\"Rayvn API key restored for: \" + restore.connection_name);\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 710,
    "y": 640,
