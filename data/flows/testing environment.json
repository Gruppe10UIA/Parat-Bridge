    "id": "3344af3fc619b8c2",
    "type": "function",
    "z": "901ed98289cc4ecd",
    "name": "toggle polling",
    "func": "const connections = global.get(\"parat_bridge.connections\");\nconst active = !!msg.payload;\n\nfor (const key of Object.keys(connections)) {\n    connections[key].active = active;\n}\n\nglobal.set(\"parat_bridge.connections\", connections);\n\nmsg.payload = { active, count: Object.keys(connections).length };\nreturn msg;\n",
