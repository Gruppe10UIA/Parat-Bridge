  {
    "id": "65326760bdf87cf5",
    "type": "function",
    "z": "84d1a0de660abb59",
    "g": "354aca9dbc391ace",
    "name": "Validate clients",
    "func": "const clients = Object.values(msg.payload);\n\nif (clients.length !== 2) {\n    node.error(\"Incomplete connection - expected 2 clients, got \" + clients.length + \". Dropping message.\");\n    return null;\n}\n\n// Verify both clients are different systems\nconst systems = clients.map(c => c.client_system);\nif (systems[0] === systems[1]) {\n    node.error(\"Invalid connection - both clients are \" + systems[0] + \". Dropping message.\");\n    return null;\n}\n\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 860,
    "y": 260,
    "wires": [
      [
        "7cf27d9c1bf7f451",
        "5ee678ae28671a86"
      ]
    ]
  },
