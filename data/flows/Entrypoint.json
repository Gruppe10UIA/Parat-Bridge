  {
    "id": "5ee678ae28671a86",
    "type": "function",
    "z": "84d1a0de660abb59",
    "name": "Prepare opprettet payload",
    "func": "/**                                                                                                                                                                 \n * Reads the current connection object from globals, then\n * hands it to Notify Connection Lifecycle.                                                                                                                         \n */\nconst utils = global.get(\"utils\");\nconst clients = Object.values(msg.payload);\nif (clients.length !== 2) return null;\n\nconst name = utils.build_connection_name(clients);\nconst connection = (global.get(\"parat_bridge.connections\") || {})[name];\n\n// Race-safety: if Initialize connection has not created it yet,                                                                                                    \n// synthesize a minimal connection object from the join payload.\nconst safe_connection = connection || {\n    name: name,\n    clients: msg.payload\n};\n\nreturn {\n    payload: safe_connection,\n    event: \"opprettet\"\n};",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1020,
