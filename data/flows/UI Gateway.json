  {
    "id": "1ad06dbe0f3f56b6",
    "type": "function",
    "z": "6d6fd7cba489171b",
    "name": "Route UIB Messages",
    "func": "if (msg.topic === 'form/submit') {\n    var rayvn = {\n        payload: {\n            rayvn_api_key: msg.payload.rayvn_api_key,\n            rayvn_log_name: msg.payload.rayvn_log_name\n        }\n    };\n\n    var wasos = {\n        payload: {\n            wasos_username: msg.payload.wasos_username,\n            wasos_password: msg.payload.wasos_password,\n            wasos_chatroom_name: msg.payload.wasos_chatroom_name\n        }\n    };\n\n    return [rayvn, wasos, null];\n}\n\nif (msg.topic === 'connection/toggle') {\n    return [null, null, msg];\n}\n\nreturn [null, null, null];",
