  {
    "id": "87c89a4224ca60f2",
    "type": "function",
    "z": "003e75aaa2880405",
    "g": "00eba3e5252a7414",
    "name": "Format connections table",
    "func": "const connections = global.get(\"parat_bridge.connections\");\n\nif (!connections) {\n    msg.payload = [];\n    return msg;\n}\n\n\nmsg.payload = Object.values(connections).map(conn => {\n    const clients = Object.values(conn.clients);\n    return {\n        \"Klient 1\": `${clients[0].client_system} — ${clients[0].name}`,\n        \"Klient 2\": `${clients[1].client_system} — ${clients[1].name}`,\n        status:     conn.active ? \"🟢 aktiv\" : \"🔴 inaktiv\",\n        created:    new Date(conn.time_created).toLocaleString()\n    };\n});\n\n\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
